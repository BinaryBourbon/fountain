    {
      "type": "row",
      "title": "What agents actually do",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 18
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Turn outcomes per hour",
      "description": "Turn rate and outcome mix. These three stages are also the ones mirrored into PostHog as conversation.turn.done and friends, so the same fact is sliceable per account there.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fountain_stage_count{namespace=\"$namespace\", stage=\"turn\", status=\"done\"}[1h])) or vector(0)",
          "legendFormat": "done"
        },
        {
          "refId": "B",
          "expr": "sum(increase(fountain_stage_count{namespace=\"$namespace\", stage=\"turn\", status=\"failed\"}[1h])) or vector(0)",
          "legendFormat": "failed"
        },
        {
          "refId": "C",
          "expr": "sum(increase(fountain_stage_count{namespace=\"$namespace\", stage=\"turn\", status=\"interrupted\"}[1h])) or vector(0)",
          "legendFormat": "interrupted"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Turn failure share",
      "description": "clamp_min keeps the panel blank rather than dividing by zero during quiet hours.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2
          },
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(fountain_stage_count{namespace=\"$namespace\", stage=\"turn\", status=\"failed\"}[1h])) / clamp_min(sum(rate(fountain_stage_count{namespace=\"$namespace\", stage=\"turn\", status=~\"done|failed|interrupted\"}[1h])), 0.0000001)",
          "legendFormat": "failed share"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Time to first output p50 / p95",
      "description": "The wait between hitting enter and seeing the agent do something. Buckets stop at 60s deliberately: past roughly 30 seconds of silence a person has already decided it is broken, so the resolution below that is where the signal lives. Runtime-agnostic, because the measurement is the first stdout bytes rather than parsed tokens.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          },
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (runtime, le) (rate(fountain_turn_first_output_elapsed_ms_bucket{namespace=\"$namespace\"}[1h])))",
          "legendFormat": "{{runtime}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (runtime, le) (rate(fountain_turn_first_output_elapsed_ms_bucket{namespace=\"$namespace\"}[1h])))",
          "legendFormat": "{{runtime}} p95"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Turn duration p50 / p95",
      "description": "How long the whole thing took, split by runtime. Pair it with the panel to its left: that one says how long it took to start.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          },
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum by (runtime, le) (rate(fountain_turn_completed_duration_ms_bucket{namespace=\"$namespace\"}[1h]))) / 1000",
          "legendFormat": "{{runtime}} p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (runtime, le) (rate(fountain_turn_completed_duration_ms_bucket{namespace=\"$namespace\"}[1h]))) / 1000",
          "legendFormat": "{{runtime}} p95"
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Conversations by status",
      "description": "Idle conversations keep a suspended sandbox and can be woken; terminated ones cannot.",
      "gridPos": {
        "h": 7,
