{
  "__comment": "Product dashboard for Fountain. Owned by the repo at deploy/grafana/fountain-product.json; see docs/guides/operate/dashboards.md. Counts and durations only. Anything needing person identity, cohorts or retention belongs on the PostHog dashboard of the same name. Funnel and status gauges are polled from the database by every replica and are identical per pod, so they use `max` and never `sum`.",
  "title": "Fountain / Product",
  "uid": "fountain-product",
  "tags": [
    "fountain",
    "product"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(fountain_conversations_count, namespace)",
          "refId": "ns"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "fountain",
          "value": "fountain"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Lifecycle funnel",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Users by lifecycle stage",
      "description": "All-time totals, polled from Fountain.Funnel. Onboarded means the account holds an inference credential and an agent (#867), not that somebody clicked through the old wizard. Activated means a first conversation, counted as the union of a conversations row and a sandbox_provisioned usage event, because either one alone under-counts. Every replica polls the same database and reports the same number, so these use `max`; `sum` would multiply the funnel by the replica count.",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(fountain_funnel_registered{namespace=\"$namespace\"})",
          "legendFormat": "registered",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "max(fountain_funnel_verified{namespace=\"$namespace\"})",
          "legendFormat": "verified",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "max(fountain_funnel_onboarded{namespace=\"$namespace\"})",
          "legendFormat": "onboarded",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "max(fountain_funnel_activated{namespace=\"$namespace\"})",
          "legendFormat": "activated",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "max(fountain_funnel_funded{namespace=\"$namespace\"})",
          "legendFormat": "funded",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Verified / registered",
      "description": "Email verification is the first gate. Login is refused while email_verified_at is nil, so a drop here means nobody gets in at all.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(fountain_funnel_verified{namespace=\"$namespace\"}) / max(fountain_funnel_registered{namespace=\"$namespace\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Onboarded / verified",
      "description": "Reaching a credential and an agent.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 15,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(fountain_funnel_onboarded{namespace=\"$namespace\"}) / max(fountain_funnel_verified{namespace=\"$namespace\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Activated / verified",
      "description": "The conversion that matters most: a verified account that ever started a conversation.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 18,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(fountain_funnel_activated{namespace=\"$namespace\"}) / max(fountain_funnel_verified{namespace=\"$namespace\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Funded / activated",
      "description": "Comped accounts are operator grants rather than conversions and are excluded. An account that spent its balance to zero drops out of this stage.",
      "gridPos": {
        "h": 4,
        "w": 3,
        "x": 21,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(fountain_funnel_funded{namespace=\"$namespace\"}) / max(fountain_funnel_activated{namespace=\"$namespace\"})"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Stalled after verifying",
      "description": "Verified accounts that never started a conversation. The admin funnel page breaks the same number down further, into built an agent, built an environment, or built nothing.",
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 12,
        "y": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(fountain_funnel_stalled_verified{namespace=\"$namespace\"})"
        }
