    },
    {
      "type": "timeseries",
      "title": "Funnel stages over time",
      "description": "Cumulative all-time counts, so these lines only ever climb. Read the slope, not the level. A flat activated line under a climbing verified line is the stall the stat above counts.",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 0,
            "lineWidth": 2
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(fountain_funnel_registered{namespace=\"$namespace\"})",
          "legendFormat": "registered"
        },
        {
          "refId": "B",
          "expr": "max(fountain_funnel_verified{namespace=\"$namespace\"})",
          "legendFormat": "verified"
        },
        {
          "refId": "C",
          "expr": "max(fountain_funnel_onboarded{namespace=\"$namespace\"})",
          "legendFormat": "onboarded"
        },
        {
          "refId": "D",
          "expr": "max(fountain_funnel_activated{namespace=\"$namespace\"})",
          "legendFormat": "activated"
        },
