{
  "__comment": "Finance dashboard for Fountain. Owned by the repo at deploy/grafana/fountain-finance.json; see docs/guides/operate/dashboards.md. Cost drivers and conversion counts, not revenue: Stripe holds the money and usage_events holds the billable record. Sandbox-minutes are an estimate sampled from a gauge and must be reconciled against the provider bill. Provider gauges are duplicated per replica, so every one collapses with `max` before any `sum`.",
  "title": "Fountain / Finance",
  "uid": "fountain-finance",
  "tags": [
    "fountain",
    "finance"
  ],
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "refresh": "5m",
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "label": "Prometheus",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "query": {
          "query": "label_values(fountain_conversations_count, namespace)",
          "refId": "ns"
        },
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "fountain",
          "value": "fountain"
        }
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "What the providers are charging for right now",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Live sandboxes by provider",
      "description": "Non-terminal sandbox rows that are pending, starting or ready. A minute on each provider is bought at a different price, which is why this is tagged by provider and not by tenant. Per-account spend is a database report rather than a series; the console has it under sandbox spend.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (provider) (fountain_sandboxes_by_provider_count{namespace=\"$namespace\", status=~\"pending|starting|ready\"})",
          "legendFormat": "{{provider}}",
          "instant": true
        }
      ]
    },
    {
      "type": "bargauge",
      "title": "Parked sandboxes by provider",
      "description": "Suspended by the idle bound. The sprite is kept so the memory survives (decisions/0017), which means a parked sandbox can still cost storage even though it is doing no work. Only the max-lifetime ceiling destroys.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "displayMode": "lcd",
        "orientation": "horizontal",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showUnfilled": true
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (provider) (fountain_sandboxes_by_provider_count{namespace=\"$namespace\", status=\"suspended\"})",
          "legendFormat": "{{provider}}",
          "instant": true
        }
      ]
    },
    {
      "type": "stat",
      "title": "Untracked sprites",
      "description": "Sprites alive at the provider with no sandbox row to bill against. This is money leaving with nothing to attribute it to. It is a level re-measured on every reaper run, so it falls when they are cleaned up.",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(fountain_reaper_untracked_count{namespace=\"$namespace\"}) or vector(0)"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Usage events dropped",
      "description": "Metering swallows its own failures by contract, so an outage looks exactly like nobody using the product. Any non-zero value here means billing rows were lost over the selected range and the invoice will under-charge (#503).",
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 20,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(increase(fountain_usage_dropped_count{namespace=\"$namespace\"}[$__range])) or vector(0)"
        }
