{
  "base_url": "https://your-fountain.example",
  "credentials": {
    "primary": "FOUNTAIN_SUITE_KEY",
    "secondary": "FOUNTAIN_SUITE_OTHER_KEY"
  },
  "profiles": ["secrets"],
  "execution": {
    "runtime": "claude",
    "model": "anthropic/claude-haiku-4-5",
    "sandbox_provider": "e2b",
    "sandbox_mode": "ephemeral",
    "provision_ms": 120000,
    "turn_ms": 90000,
    "max_turns": 1
  },
  "secrets": {
    "allowed_url": "https://allowed-suite.example.com",
    "blocked_url": "https://blocked-suite.example.com",
    "admin_credential": "FOUNTAIN_RECEIVER_ADMIN_KEY",
    "bootstrap_hosts": ["registry.npmjs.org"]
  },
  "limits": {
    "request_ms": 30000,
    "run_ms": 360000,
    "cleanup_ms": 90000,
    "resources": 5
  }
}
