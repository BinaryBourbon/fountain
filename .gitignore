# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here. Unanchored: in an
# umbrella the reports land in apps/*/cover/ as well as at the root, and while
# the root pattern was anchored a generated excoveralls.json sat committed in
# apps/fountain/cover/ from b1bc89c until #620.
cover/

# Local build outputs (CLI binaries in CI, `mix openapi.export` locally).
/dist/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Temporary files, for example, from tests.
/tmp/

# Database files
*.db
*.db-*

# Built escripts
/aod

# Burrito-wrapped releases (build output)
/burrito_out/

# Environment files
.env
.env.local

# Seed dumps may contain real tokens — never commit
/priv/seeds/*.yaml
/priv/seeds/*.json


# Operator's local AoD manifest — contains MCP bearer tokens.
aod.yml

# Static docs build output (mkdocs)
/_site/

# Built escript outputs.
/aod
/apps/*/aod

# Burrito output.
/burrito_out/


# mkdocs build output
site/
priv/plts/

# Python (integrations/hermes)
__pycache__/
*.pyc
