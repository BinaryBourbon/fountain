    {
      "type": "timeseries",
      "title": "Setup and model failures per hour",
      "description": "The two stages that end an activation attempt before any output. Both reach PostHog as well, so an account-level view of who hit them is one query away there.",
      "gridPos": {
        "h": 7,
        "w": 16,
        "x": 8,
        "y": 35
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 15,
            "lineWidth": 2,
            "stacking": {
              "mode": "normal"
            }
          },
          "min": 0
        },
        "overrides": []
      },
